{
  "name": "luma-player",
  "version": "1.6.1",
  "private": true,
  "type": "module",
  "description": "A Windows music player for local files, native mixes, karaoke and open audio catalogs",
  "author": "Luma contributors",
  "license": "GPL-3.0-only",
  "main": "dist-electron/electron/main.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run build:electron && node scripts/dev.mjs",
    "dev:web": "vite --host 0.0.0.0",
    "start": "electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json",
    "build:native": "node scripts/build-native.mjs",
    "build:electron": "tsc -p tsconfig.electron.json && node scripts/build-electron-assets.mjs",
    "build": "npm run typecheck && vite build && npm run build:electron && npm run build:native",
    "test": "tsx --test \"tests/*.test.ts\"",
    "dist:win": "npm run build && npm run package:win",
    "package:win": "electron-builder --win --x64 --publish never",
    "test:package": "electron tests/package-smoke.mjs",
    "test:installed": "node tests/installed-smoke.mjs",
    "test:desktop": "electron tests/desktop-smoke.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "lucide-react": "^0.577.0",
    "music-metadata": "^12.7.0",
    "node-id3": "0.2.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^24.9.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "45.3.4",
    "electron-builder": "^26.18.0",
    "rusty-chromaprint-wasm": "0.1.5",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^7.3.8"
  }
}
